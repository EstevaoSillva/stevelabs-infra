# =====================================================================
#  TUDO LOCAL, OFFLINE, EM 16 GB — só para demonstração.
#  Leia o parecer no README: o modelo que cabe aqui é fraco em chamar
#  ferramentas e criar subagentes, e a máquina fica no limite de memória.
#
#  O Ollama roda em contêiner, dentro do WSL, junto com o resto (perfil llm).
#  O contêiner "ollama-baixar-modelos" baixa os modelos no primeiro "up".
#  Antes, aumente o WSL para 12 GB no .wslconfig (ver config/wslconfig-16gb.example).
#  Gere o .env no terminal do WSL:  bash scripts/gerar-env.sh local
# =====================================================================
COMPOSE_PROFILES=llm
BIND_IP=127.0.0.1

MODELO_LLM=gemma4:12b
MODELO_SUBAGENTE=
MODELO_EMBEDDING=qwen3-embedding:0.6b
NUM_CTX=8192
OLLAMA_NUM_PARALLEL=1
MAX_PROFUNDIDADE_SUBAGENTES=1
LIMITE_CHAMADAS_FERRAMENTA=12

OLLAMA_HOST=http://ollama:11434
DOCLING_URL=
DOCLING_API_KEY=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
S3_ENDPOINT=

URL_PUBLICA_AGENTES=http://localhost:8000
URL_PUBLICA_CHAT=http://localhost:3080

POSTGRES_PASSWORD=__SENHA__
AGENTES_API_KEY=__SENHA__
SENHA_ARQUIVOS=
# Só são usados se você ligar o perfil ui (+1,5 GB de RAM):
LIBRECHAT_CREDS_KEY=__HEX64__
LIBRECHAT_CREDS_IV=__HEX32__
LIBRECHAT_JWT_SECRET=__HEX64__
LIBRECHAT_JWT_REFRESH_SECRET=__HEX64__
