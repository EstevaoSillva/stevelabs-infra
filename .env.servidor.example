# =====================================================================
#  SERVIDOR CENTRAL (GPU) — sobe a stack completa, usada por todos pela rede
#  Gere o .env com:  ./scripts/gerar-env.sh servidor
#  Depois troque SERVIDOR pelo IP ou nome do host em todas as URL_PUBLICA_*
# =====================================================================
COMPOSE_PROFILES=ui,llm,docling,obs
BIND_IP=0.0.0.0

# ── Modelos (Ollama) ────────────────────────────────────────────────
# GPU 24 GB: gemma4:26b (MoE, 19 GB) ou qwen3.6:27b (18 GB)
# GPU 48 GB: gemma4:31b (20 GB) com contexto maior e mais usuários simultâneos
MODELO_LLM=gemma4:26b
MODELO_SUBAGENTE=
MODELO_EMBEDDING=qwen3-embedding:0.6b
NUM_CTX=32768
OLLAMA_NUM_PARALLEL=4
MAX_PROFUNDIDADE_SUBAGENTES=1
LIMITE_CHAMADAS_FERRAMENTA=25

# ── Endereços internos (rede do compose) ────────────────────────────
OLLAMA_HOST=http://ollama:11434
DOCLING_URL=http://docling:5001
LANGFUSE_HOST=http://langfuse-web:3000
S3_ENDPOINT=http://seaweedfs:8333

# ── Endereços públicos (o que o navegador dos usuários enxerga) ─────
URL_PUBLICA_AGENTES=http://SERVIDOR:8000
URL_PUBLICA_CHAT=http://SERVIDOR:3080
URL_PUBLICA_LANGFUSE=http://SERVIDOR:3000
URL_PUBLICA_S3=http://SERVIDOR:8333

# ── Segredos (o script substitui os marcadores __...__) ─────────────
POSTGRES_PASSWORD=__SENHA__
AGENTES_API_KEY=__SENHA__
SENHA_ARQUIVOS=__SENHA__
DOCLING_API_KEY=__SENHA__
LIBRECHAT_CREDS_KEY=__HEX64__
LIBRECHAT_CREDS_IV=__HEX32__
LIBRECHAT_JWT_SECRET=__HEX64__
LIBRECHAT_JWT_REFRESH_SECRET=__HEX64__
LANGFUSE_SALT=__HEX32__
LANGFUSE_ENCRYPTION_KEY=__HEX64__
LANGFUSE_NEXTAUTH_SECRET=__HEX32__
LANGFUSE_PUBLIC_KEY=pk-lf-__HEX32__
LANGFUSE_SECRET_KEY=sk-lf-__HEX32__
LANGFUSE_ADMIN_EMAIL=seu.email@exemplo.com
LANGFUSE_ADMIN_PASSWORD=__SENHA__
CLICKHOUSE_PASSWORD=__SENHA__
REDIS_PASSWORD=__SENHA__
S3_ACCESS_KEY=__HEX32__
S3_SECRET_KEY=__HEX64__
