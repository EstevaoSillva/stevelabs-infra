# =====================================================================
#  PC DE ALUNO 16 GB (modo híbrido) — roda só o núcleo + chat localmente;
#  modelo, Docling e Langfuse ficam no servidor central.
#  Consumo esperado: ~4 a 5 GB de RAM dentro do WSL.
#  Gere o .env no terminal do WSL:  bash scripts/gerar-env.sh aluno
#  Depois troque IP_DO_SERVIDOR pelo endereço do servidor central.
# =====================================================================
COMPOSE_PROFILES=ui
BIND_IP=127.0.0.1

# ── Modelo: o mesmo que o servidor serve ────────────────────────────
MODELO_LLM=gemma4:26b
MODELO_SUBAGENTE=
MODELO_EMBEDDING=qwen3-embedding:0.6b
NUM_CTX=16384
MAX_PROFUNDIDADE_SUBAGENTES=1
LIMITE_CHAMADAS_FERRAMENTA=25

# ── Serviços remotos (servidor central) ─────────────────────────────────
OLLAMA_HOST=http://IP_DO_SERVIDOR:11434
DOCLING_URL=http://IP_DO_SERVIDOR:5001
DOCLING_API_KEY=PEDIR_AO_RESPONSAVEL
LANGFUSE_HOST=http://IP_DO_SERVIDOR:3000
LANGFUSE_PUBLIC_KEY=pk-lf-PEDIR_AO_RESPONSAVEL
LANGFUSE_SECRET_KEY=sk-lf-PEDIR_AO_RESPONSAVEL
S3_ENDPOINT=

# ── Endereços locais ────────────────────────────────────────────────
URL_PUBLICA_AGENTES=http://localhost:8000
URL_PUBLICA_CHAT=http://localhost:3080

# ── Segredos locais (o script substitui os marcadores) ──────────────
POSTGRES_PASSWORD=__SENHA__
AGENTES_API_KEY=__SENHA__
SENHA_ARQUIVOS=
LIBRECHAT_CREDS_KEY=__HEX64__
LIBRECHAT_CREDS_IV=__HEX32__
LIBRECHAT_JWT_SECRET=__HEX64__
LIBRECHAT_JWT_REFRESH_SECRET=__HEX64__
